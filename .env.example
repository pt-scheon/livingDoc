# Copy to .env (docker compose reads it) or set these in your host's dashboard. Never commit the real .env.

# REQUIRED when the app is reachable from the internet. It is the SETUP CODE for creating the first (owner) account,
# and it also works on its own as a break-glass owner sign-in. Empty = open mode until someone creates an account (local use only).
LIVINGDOC_ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Optional: an AI model for Hindi/Gujarati notes. Without it an English-only rule reader is used.
# Default is Groq's OpenAI-compatible API; any OpenAI-compatible service or a local Ollama works.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_key_here
# LLM_MODEL=openai/gpt-oss-20b

# Optional tuning
# LIVINGDOC_SYNC_SECONDS=3600
# LIVINGDOC_FORESIGHT_LIVE=1        # 0 = never call the weather / web-trend services
# LIVINGDOC_CSP=1                   # 0 = turn off the Content-Security-Policy header
